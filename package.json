{
  "name": "carte-qr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/e2e/*.e2e.ts\""
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "typescript": "^6.0.0",
    "@types/node": "^22.18.0"
  }
}
