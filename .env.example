# Adresse publique de l'application, sans slash final
BASE_URL=https://carte.exemple.ch
PORT=3000
# Interface d'écoute : 127.0.0.1 derrière un reverse proxy (recommandé), 0.0.0.0 dans Docker
HOST=127.0.0.1
# Nombre de proxys de confiance devant l'application (1 avec Caddy/Nginx, 0 si exposée directement)
TRUST_PROXY_HOPS=1
# Dossier des données (base SQLite et photos)
DATA_DIR=./data
# Seule adresse autorisée à se connecter à l'administration
ADMIN_EMAIL=toi@exemple.ch
# Nom affiché comme responsable du traitement et nom de la première carte
OWNER_NAME=Benjamin Vallée
# Chaîne aléatoire d'au moins 32 caractères (openssl rand -hex 32)
SESSION_SECRET=
# Envoi des e-mails (Infomaniak : mail.infomaniak.com, port 465)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Carte QR <carte@exemple.ch>
# Folk (facultatif) : clé d'API et identifiant du groupe de destination
FOLK_API_KEY=
FOLK_GROUP_ID=
# Sauvegarde S3 (facultatif mais fortement recommandé) : Infomaniak Object Storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
